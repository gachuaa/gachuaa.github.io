---
import '@fontsource-variable/inter';
import '../styles/theme.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Navigation from '../components/Navigation.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import {site,url} from '../lib/content';
const {title,description=site.tagline,active='home',note=false,reading=false,draft=false,sidebarCollapsible=false,canonicalPath=Astro.url.pathname}=Astro.props;
const canonical=new URL(canonicalPath,site.url).href;
---
<!doctype html>
<html lang="en" data-theme="light">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title?`${title} · ${site.name}`:site.name}</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/><link rel="icon" href={url('/favicon.svg')} type="image/svg+xml"/>
  <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={url('/rss.xml')}/>
  <meta property="og:title" content={title||site.name}/><meta property="og:description" content={description}/><meta property="og:type" content={reading?'article':'website'}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/>
  {draft&&<meta name="robots" content="noindex,nofollow"/>}
  <script is:inline>
   (()=>{let preference='system';try{preference=localStorage.getItem('snipper-theme')||'system';}catch{}if(!['light','dark','system'].includes(preference))preference='system';document.documentElement.dataset.theme=preference==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):preference;document.documentElement.dataset.themePreference=preference;})();
  </script>
 </head>
 <body class:list={{'note-mode':note,'reader-mode':reading,'sidebar-collapsible':sidebarCollapsible}} data-base={site.base}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="shell">
   <aside class="primary-sidebar" data-pagefind-ignore><Navigation active={active} compact={sidebarCollapsible}/></aside>
   <div class="workspace">
    <header class="topbar" data-pagefind-ignore>
     <button type="button" class="back-button" data-go-back aria-label="Go back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/><path d="M9 12h10"/></svg></button>
     <button class="icon-button mobile-menu" data-open="navigation-dialog" aria-label="Open navigation"><Icon name="menu"/></button>
     <form class="global-search" action={url('/search/')} role="search" data-global-search-form><Icon name="search"/><input aria-label="Search posts and notes" name="q" placeholder="Search posts and notes…" autocomplete="off"/><kbd aria-hidden="true">Ctrl K</kbd></form>
     {reading&&<button class="button focus-toggle" data-focus aria-pressed="false"><Icon name="focus" size={17}/><span>Focus</span></button>}
    </header>
    <main id="main" tabindex="-1"><slot/></main>
   </div>
  </div>
  <SearchOverlay/>
  <dialog id="navigation-dialog" class="drawer navigation-drawer" aria-label="Navigation"><div class="dialog-heading"><strong>Navigation</strong><button class="icon-button" data-close aria-label="Close navigation"><Icon name="close"/></button></div><Navigation active={active}/></dialog>
    <dialog class="media-lightbox" data-media-lightbox aria-label="Image preview">
     <button type="button" class="icon-button media-lightbox-close" data-close aria-label="Close image preview"><Icon name="close"/></button>
      <div class="media-lightbox-controls" aria-label="Image zoom controls">
       <button type="button" class="icon-button" data-media-zoom-out aria-label="Zoom out" title="Zoom out">−</button>
       <output data-media-zoom-level>Fit</output>
       <button type="button" class="icon-button" data-media-zoom-in aria-label="Zoom in" title="Zoom in">+</button>
       <button type="button" class="icon-button" data-media-zoom-reset aria-label="Fit image to view" title="Fit image">Fit</button>
      </div>
      <div class="media-lightbox-viewport" data-media-lightbox-viewport>
      <img data-media-lightbox-image alt="" tabindex="0" role="button" aria-label="Press Enter or click to close zoomed image"/>
      </div>
    </dialog>
  <slot name="dialogs"/>
  <script>
   const mediaRoot = document.documentElement;
   const mediaBody = document.body;
   let mediaScrollY = 0;
  let mediaZoom = 1;
  const mediaDialog = document.querySelector('[data-media-lightbox]');
  const mediaPreview = mediaDialog?.querySelector('[data-media-lightbox-image]');
  const mediaZoomLevel = mediaDialog?.querySelector('[data-media-zoom-level]');
  const mediaZoomOut = mediaDialog?.querySelector('[data-media-zoom-out]');
  const mediaZoomIn = mediaDialog?.querySelector('[data-media-zoom-in]');
  const mediaViewport = mediaDialog?.querySelector('[data-media-lightbox-viewport]');
  let mediaFitWidth = 0;
   const setMediaZoom = (zoom, anchor) => {
    const previousZoom = mediaZoom;
    const viewportRect = anchor ? mediaViewport?.getBoundingClientRect() : null;
    const imageRect = anchor ? mediaPreview?.getBoundingClientRect() : null;
   mediaZoom = Math.min(3, Math.max(1, zoom));
   if (mediaPreview?.naturalWidth && mediaViewport) {
    const fitScale = Math.min(mediaViewport.clientWidth / mediaPreview.naturalWidth, mediaViewport.clientHeight / mediaPreview.naturalHeight);
    mediaFitWidth = mediaPreview.naturalWidth * fitScale;
    mediaPreview.style.width = `${mediaFitWidth * mediaZoom}px`;
      if (anchor && viewportRect && imageRect) {
       const factor = mediaZoom / previousZoom;
       mediaViewport.scrollTo({
         left: (anchor.clientX - imageRect.left) * factor - (anchor.clientX - viewportRect.left),
         top: (anchor.clientY - imageRect.top) * factor - (anchor.clientY - viewportRect.top),
         behavior: 'instant'
       });
      } else {
       mediaViewport.scrollTo({
         left: Math.max(0, (mediaPreview.clientWidth - mediaViewport.clientWidth) / 2),
         top: Math.max(0, (mediaPreview.clientHeight - mediaViewport.clientHeight) / 2),
         behavior: 'instant'
       });
      }
   }
   if (mediaZoomLevel) mediaZoomLevel.textContent = mediaZoom === 1 ? 'Fit' : `${Math.round(mediaZoom * 100)}%`;
   if (mediaZoomOut) mediaZoomOut.disabled = mediaZoom === 1;
   if (mediaZoomIn) mediaZoomIn.disabled = mediaZoom === 3;
  };
  mediaPreview?.addEventListener('load', () => setMediaZoom(mediaZoom));
   mediaViewport?.addEventListener('wheel', (event) => {
    event.preventDefault();
    if (event.deltaY) setMediaZoom(mediaZoom * Math.exp(-event.deltaY * .00065), event);
   }, {passive:false});
  mediaZoomOut?.addEventListener('click', () => setMediaZoom(mediaZoom - .25));
  mediaZoomIn?.addEventListener('click', () => setMediaZoom(mediaZoom + .25));
  mediaDialog?.querySelector('[data-media-zoom-reset]')?.addEventListener('click', () => setMediaZoom(1));
     const openMediaPreview = (image) => {
        const dialog = document.querySelector('[data-media-lightbox]');
        const preview = dialog?.querySelector('[data-media-lightbox-image]');
        if (!dialog || !preview) return;
        mediaScrollY = window.scrollY;
        preview.src = image.currentSrc || image.src;
        preview.alt = image.alt;
      setMediaZoom(1);
      if (preview.complete) setMediaZoom(1);
      mediaRoot.classList.add('media-scroll-lock');
      mediaBody.style.setProperty('--media-scroll-top', `-${mediaScrollY}px`);
      mediaBody.classList.add('media-dialog-open');
        dialog.showModal();
        preview.focus({preventScroll:true});
     };
     mediaDialog?.addEventListener('close', () => {
      mediaBody.classList.remove('media-dialog-open');
      mediaBody.style.removeProperty('--media-scroll-top');
        const restoreScroll = () => window.scrollTo({top: mediaScrollY, left: 0, behavior: 'instant'});
        restoreScroll();
        requestAnimationFrame(() => {
         restoreScroll();
         if (!mediaDialog.open) mediaRoot.classList.remove('media-scroll-lock');
        });
     });
    mediaDialog?.addEventListener('click', (event) => {
     const target = event.target instanceof Element ? event.target : null;
     if (target?.closest('[data-media-lightbox-image], .media-lightbox-controls, .media-lightbox-close')) return;
     mediaDialog.close();
    });
     document.querySelectorAll('.prose img').forEach((image) => {
        image.tabIndex = 0;
        image.setAttribute('role', 'button');
        image.setAttribute('aria-label', `Open full-size image${image.alt ? `: ${image.alt}` : ''}`);
     });
   document.addEventListener('click', (event) => {
       const zoomedPreview = event.target instanceof Element ? event.target.closest('[data-media-lightbox-image]') : null;
       if (zoomedPreview) {
        mediaDialog?.close();
        return;
       }
        const clicked = event.target instanceof Element ? event.target.closest('.prose img') : null;
        const image = clicked instanceof HTMLImageElement ? clicked : null;
        const spoiler = image?.closest('.spoiler');
        if (image && spoiler && !spoiler.classList.contains('revealed')) {
         spoiler.classList.add('revealed');
         return;
        }
        if (image) {
         openMediaPreview(image);
         return;
        }
        const target = event.target instanceof Element ? event.target.closest('.spoiler') : null;
    if (!target) return;
    target.classList.toggle('revealed');
   });
     document.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const zoomedPreview = event.target instanceof Element ? event.target.closest('[data-media-lightbox-image]') : null;
        if (zoomedPreview) {
        event.preventDefault();
        mediaDialog?.close();
        return;
        }
        const clicked = event.target instanceof Element ? event.target.closest('.prose img[tabindex]') : null;
        const image = clicked instanceof HTMLImageElement ? clicked : null;
        if (!image) return;
        event.preventDefault();
        const spoiler = image.closest('.spoiler');
        if (spoiler && !spoiler.classList.contains('revealed')) spoiler.classList.add('revealed');
        else openMediaPreview(image);
     });
  </script>
  <script>import '../lib/client';</script>
 </body>
</html>
