---
import TypeTabs from './TypeTabs.astro';
import {taxonomy,topicEntries,url} from '../lib/content';
const {all}=Astro.props;
---
<div class="page" data-search-page><p class="sr-only" data-search-summary aria-live="polite">Search titles, headings, and page content.</p><div class="search-controls"><TypeTabs filter/><label class="sr-only" for="search-topic">Filter by topic</label><select id="search-topic" data-search-topic><option value="">Any topic</option>{Object.keys(taxonomy.topics).filter(id=>topicEntries(all,id).length).map(id=><option value={id}>{taxonomy.topics[id].label}</option>)}</select></div><div class="search-results" data-search-results aria-live="polite"></div><div class="pagination" data-search-pagination hidden><button class="button" data-search-previous>Previous</button><span data-search-page-label class="small muted"></span><button class="button" data-search-next>Next</button></div><p class="search-note">You can also <a class="text-link" href={url('/topics/')}>browse by topic</a>.</p><noscript><p>Search needs JavaScript. All entries are available from <a href={url('/archives/')}>Archives</a>.</p></noscript></div>
